<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect /public/index.php to the main domain
    RewriteCond %{THE_REQUEST} \s/+public/index\.php[\s?] [NC]
    RewriteRule ^public/index\.php$ / [R=302,L]

    # Internally load the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
